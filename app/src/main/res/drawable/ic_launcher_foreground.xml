<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined address book glyph: thin black strokes on white, e-ink friendly. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:pivotX="54"
        android:pivotY="54">

        <!-- book cover -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3.5"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M37,31 H73 A4,4 0 0 1 77,35 V73 A4,4 0 0 1 73,77 H37 A4,4 0 0 1 33,73 V35 A4,4 0 0 1 37,31 Z" />

        <!-- binder rings -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M29,42 H37 M29,54 H37 M29,66 H37" />

        <!-- person: head -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3"
            android:fillColor="#00000000"
            android:pathData="M56,46 m-6,0 a6,6 0 1 0 12,0 a6,6 0 1 0 -12,0" />

        <!-- person: shoulders -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M45,67 C45,60 49,56 56,56 C63,56 67,60 67,67" />
    </group>
</vector>
